# POE-OSINT — configurazione
#
# Copia questo file in ".env" (stessa cartella) e riempi solo cio' che ti serve.
# ".env" e' gia' escluso da git (vedi .gitignore alla radice) — non finisce mai
# in un commit. Le API key si possono anche incollare dalla UI (status bar ->
# "API"), che scrive qui via app/env_writer.py.
#
# Formato: una riga per chiave, NOME=valore (nessuno spazio intorno all'uguale).
# Riga vuota o assente = quel servizio resta un link esterno cliccabile nel
# catalogo OSINT — nessuna funzionalita' si rompe se non compili nulla qui: la
# pipeline di estrazione e' deterministica e offline.
#
# tests/test_env_example.py verifica che questo file resti allineato alle
# variabili realmente lette dal codice.

# ─── API key servizi esterni ────────────────────────────────────────────────

# https://www.abuseipdb.com/account/api — free tier: 1000 check/giorno
ABUSEIPDB_API_KEY=

# https://www.virustotal.com/gui/my-apikey — free tier: 4 richieste/minuto
VIRUSTOTAL_API_KEY=

# https://account.shodan.io/ — free tier limitato, a pagamento per uso serio.
# Opzionale anche fra le opzionali: senza, POE usa gia' InternetDB (gratuito,
# senza account) e mostra porte/CVE/tag nella scheda IOC.
SHODAN_API_KEY=

# https://auth.abuse.ch/ — chiave GRATUITA, abilita ThreatFox + URLhaus (una
# sola key per entrambi). Dev'essere la Auth-Key del portale account: una
# vecchia chiave API risponde 403 unknown_auth_key.
ABUSECH_API_KEY=

# https://otx.alienvault.com/api — chiave GRATUITA, copre tutti gli IOC
# (IP/dominio/URL/hash/CVE)
OTX_API_KEY=

# https://hunter.io/api-keys — free tier: 25 verifiche email/mese
HUNTER_API_KEY=

# https://www.ipqualityscore.com/create-account — free tier limitato,
# fraud score email+telefono
IPQS_API_KEY=

# https://numverify.com/product — free tier: 100 richieste/mese,
# validazione telefono
NUMVERIFY_API_KEY=

# https://emailrep.io/key — reputazione indirizzo email
EMAILREP_API_KEY=

# ─── Backend LLM ────────────────────────────────────────────────────────────

# Quale motore AI usare. Lasciandolo VUOTO, POE guarda la macchina e sceglie da
# solo, preferendo i motori locali al cloud: MLX su Apple Silicon, altrimenti
# Ollama, altrimenti un server compatibile OpenAI, altrimenti Claude.
# Una scelta esplicita vince, ma solo se realizzabile: chiedere mlx su un PC
# non-Apple non lo fa funzionare, e POE ripiega dicendo perche'.
#   mlx     locale, solo Apple Silicon (Mac M1 o successivi)
#   ollama  locale, qualunque hardware — richiede Ollama avviato
#   openai  qualunque server compatibile OpenAI (vedi POE_OPENAI_* piu' sotto)
#   claude  via abbonamento Claude Code, non l'API a consumo
# Si sceglie anche da "Servizi & API" nell'interfaccia: la scelta viene scritta
# qui e sopravvive al riavvio.
POE_LLM_BACKEND=

# Override del modello locale (vuoto = default del backend).
POE_LLM_MODEL=

# 0 per saltare il warmup dell'LLM all'avvio: boot piu' rapido, prima risposta
# piu' lenta.
POE_LLM_WARMUP=

# Backend claude: usa il tuo ABBONAMENTO via Claude Code (`claude -p`), NON
# l'API a token. NON impostare ANTHROPIC_API_KEY: POE la rimuove comunque
# dall'ambiente del subprocess, per garantire zero addebiti per-token.
POE_CLAUDE_MODEL=
POE_CLAUDE_BIN=
POE_CLAUDE_EXTRA_ARGS=

# ─── Server compatibile OpenAI (POE_LLM_BACKEND=openai) ─────────────────────
# Un solo backend copre tutto cio' che parla il protocollo OpenAI: fra questi
# servizi cambia l'indirizzo, non l'API.
#   LM Studio      http://localhost:1234/v1
#   llama.cpp      http://localhost:8080/v1
#   vLLM / LocalAI http://localhost:8000/v1
#   OpenRouter     https://openrouter.ai/api/v1
# L'indirizzo deve finire con /v1.
#
# PRIVACY: localhost e rete privata (192.168.x, 10.x, ...) restano LOCALI —
# POE non ne fa uscire nulla e non lo segnala. Un dominio pubblico (OpenRouter,
# un endpoint aziendale via Internet) manda i dati analizzati fuori dalla
# macchina: POE lo rileva da solo e lo scrive nei log all'avvio.
POE_OPENAI_BASE_URL=

# Nome del modello, come lo chiama quel server (es. qwen3-8b).
POE_OPENAI_MODEL=

# Opzionale: molti server locali non vogliono alcuna chiave. Se il tuo non la
# vuole lasciala vuota — un header di autorizzazione vuoto viene spesso
# rifiutato come malformato.
POE_OPENAI_API_KEY=

# Timeout in secondi per le chiamate al server AI (default 120).
POE_OPENAI_TIMEOUT=

# ─── Connettore MCP (poe_mcp/) e sviluppo ───────────────────────────────────

# 1 abilita il tier LIVE_KEYLESS dei tool MCP (lookup di rete senza chiave,
# es. crt.sh). I tier GATED e FORBIDDEN restano sempre disattivati.
POE_MCP_LIVE=

# 1 popola il DB con osservazioni demo al primo avvio (SOLO SVILUPPO).
# Vedi app/demo_seed.py. Non attivarlo su un'istanza con dati reali.
POE_DEMO_DATA=
